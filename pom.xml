package com.randomlootpvp.listeners;

import com.randomlootpvp.RandomLootPvP;
import org.bukkit.Material;
import org.bukkit.block.Block;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.EventPriority;
import org.bukkit.event.Listener;
import org.bukkit.event.player.PlayerInteractEvent;
import org.bukkit.inventory.EquipmentSlot;

public class ChestInteractListener implements Listener {

    private final RandomLootPvP plugin;

    public ChestInteractListener(RandomLootPvP plugin) {
        this.plugin = plugin;
    }

    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
    public void onInteract(PlayerInteractEvent event) {
        // Only care about main-hand right-clicks on blocks
        if (event.getHand() != EquipmentSlot.HAND) return;
        if (event.getClickedBlock() == null) return;

        Block block = event.getClickedBlock();
        if (block.getType() != Material.CHEST) return;

        Player player = event.getPlayer();

        if (plugin.getChestManager().isTrackedChest(block.getLocation())) {
            plugin.getChestManager().markOpened(block.getLocation());
            player.sendMessage("§6[RandomLoot] §aYou found a loot chest! Grab the gear!");

            // Broadcast to nearby players (within 200 blocks)
            block.getWorld().getNearbyPlayers(block.getLocation(), 200).forEach(nearby -> {
                if (!nearby.equals(player)) {
                    nearby.sendMessage("§6[RandomLoot] §c" + player.getName() + " §eis looting a chest nearby!");
                }
            });
        }
    }
}
